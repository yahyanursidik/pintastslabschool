---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import siteSettings from '../content/siteSettings/siteSettings.json';

interface Props {
  title: string;
  description?: string;
  image?: string;
  favicon?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteSettings.description,
  image = siteSettings.logo,
  favicon = siteSettings.favicon || '/favicon.svg',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f4ea" />
    <link rel="icon" href={favicon} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteSettings.schoolName} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, canonical)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Langsung ke isi halaman</a>
    <SiteHeader
      schoolName={siteSettings.schoolName}
      shortName={siteSettings.shortName}
      logo={siteSettings.logo}
    />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter schoolName={siteSettings.schoolName} />
  </body>
</html>
