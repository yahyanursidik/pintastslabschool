---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import siteSettings from '../content/siteSettings/siteSettings.json';
---

<Layout title={'Halaman tidak ditemukan | ' + siteSettings.schoolName} noindex>
  <section class="inner-page error-page" aria-labelledby="error-title">
    <h1 id="error-title">Halaman tidak ditemukan.</h1>
    <p>Buka beranda untuk mencari program, informasi pendaftaran, atau kontak sekolah.</p>
    <Button href="/">Kembali ke beranda</Button>
  </section>
</Layout>
