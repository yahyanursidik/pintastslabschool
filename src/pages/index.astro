---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import FeaturedAnnouncement from '../components/hub/FeaturedAnnouncement.astro';
import QuickLinksGrid from '../components/hub/QuickLinksGrid.astro';
import artwork from '../assets/images/alat-permainan-edukatif.webp';
import { formatSchoolDate } from '../lib/dates';
import { uniqueShortcuts } from '../lib/shortcuts';
import settings from '../content/siteSettings/siteSettings.json';

const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Jakarta' }).format();
const [links, announcements, programs, updates] = await Promise.all([
  getCollection('quickLinks', ({ data }) => data.isActive && Boolean(data.url) && data.url !== '#'),
  getCollection('announcements', ({ data }) => (
    data.isActive &&
    (!data.startDate || data.startDate.slice(0, 10) <= today) &&
    (!data.endDate || data.endDate.slice(0, 10) >= today)
  )),
  getCollection('programs', ({ data }) => data.isActive),
  getCollection('updates', ({ data }) => data.isPublished),
]);

links.sort((a, b) => a.data.sortOrder - b.data.sortOrder || a.id.localeCompare(b.id));
announcements.sort((a, b) => (b.data.startDate ?? '').localeCompare(a.data.startDate ?? ''));
programs.sort((a, b) => a.data.sortOrder - b.data.sortOrder);
updates.sort((a, b) => b.data.publishedDate.localeCompare(a.data.publishedDate));

const admissions = links.filter(({ data }) => data.category === 'spmb');
const nonAdmissions = links.filter(({ data }) => data.category !== 'spmb').map(({ data }) => data);
const pinned = nonAdmissions.filter((link) => link.isFeatured);
const directory = nonAdmissions.filter((link) => !link.isFeatured);

const programLinks = programs.flatMap(({ data }) => data.ctaUrl
  ? [{ title: data.ctaLabel || data.title, url: data.ctaUrl }]
  : []
);
const groups = [
  {
    id: 'programs',
    title: 'Profil dan program',
    jump: 'Profil',
    links: uniqueShortcuts([
      ...directory.filter(({ category }) => category === 'download'),
      ...programLinks,
      { id: 'cara-belajar', title: 'Cara belajar di ' + settings.shortName, url: 'https://tslabschool.sch.id/pendekatan/' },
    ]),
  },
  {
    id: 'layanan',
    title: 'Layanan dan informasi',
    jump: 'Layanan',
    links: directory.filter(({ category }) => !['download', 'social', 'contact'].includes(category)),
  },
  {
    id: 'kanal',
    title: 'Kanal sekolah',
    jump: 'Kanal',
    links: uniqueShortcuts([
      ...directory.filter(({ category }) => category === 'social'),
      { title: 'Instagram sekolah', url: settings.instagramUrl },
    ]),
  },
  {
    id: 'updates',
    title: 'Kabar sekolah',
    links: updates.map(({ id, data }) => ({
      title: data.title,
      url: '/updates/' + id,
      description: formatSchoolDate(data.publishedDate),
    })),
  },
  {
    id: 'contact',
    title: 'Kontak dan lokasi',
    jump: 'Kontak',
    links: uniqueShortcuts([
      { title: 'WhatsApp School Center', url: settings.whatsappUrl },
      { title: 'Lokasi sekolah', url: settings.mapsUrl, description: settings.address },
      ...(settings.email ? [{ title: settings.email, url: 'mailto:' + settings.email }] : []),
      ...(settings.secondaryCtaLabel && settings.secondaryCtaUrl !== '#contact'
        ? [{ title: settings.secondaryCtaLabel, url: settings.secondaryCtaUrl }]
        : []),
      ...directory.filter(({ category }) => category === 'contact'),
    ]),
  },
].filter(({ links }) => links.length > 0);

const socialImage = await getImage({
  src: artwork,
  format: 'jpg',
  width: 1200,
  height: 630,
  fit: 'cover',
  quality: 80,
});
---

<Layout title={'Pintas | ' + settings.schoolName} image={socialImage.src}>
  <div class="shell hub" id="tautan">
    <FeaturedAnnouncement
      announcements={announcements}
      portals={admissions}
      image={artwork}
      primaryCtaLabel={settings.primaryCtaLabel}
      primaryCtaUrl={settings.primaryCtaUrl}
      whatsappUrl={settings.whatsappUrl}
    />

    {pinned.length > 0 && (
      <QuickLinksGrid id="akses-cepat" title="Akses cepat" links={pinned} priority />
    )}

    <nav class="hub-jump" aria-label="Kelompok tautan">
      <ul>
        {groups.filter(({ jump }) => jump).map(({ id, jump }) => (
          <li><a href={'#' + id}>{jump}</a></li>
        ))}
      </ul>
    </nav>

    {groups.map(({ id, title, links }) => (
      <QuickLinksGrid id={id} title={title} links={links} />
    ))}
  </div>
</Layout>
