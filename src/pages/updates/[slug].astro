---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import siteSettings from '../../content/siteSettings/siteSettings.json';
import { formatSchoolDate } from '../../lib/dates';

export async function getStaticPaths() {
  const entries = await getCollection('updates', ({ data }) => data.isPublished);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'updates'>;
}

const { entry } = Astro.props;
const { title, excerpt, coverImage, publishedDate } = entry.data;
const { Content } = await render(entry);
---

<Layout title={title + ' | ' + siteSettings.schoolName} description={excerpt} image={coverImage}>
  <article class="inner-page">
    <a class="text-link" href="/#updates">Kembali ke kabar sekolah</a>
    <header>
      <time class="article-date" datetime={publishedDate}>{formatSchoolDate(publishedDate)}</time>
      <h1>{title}</h1>
    </header>
    {coverImage && (
      <figure class="article-cover">
        <img src={coverImage} alt="" fetchpriority="high" />
      </figure>
    )}
    <div class="article-body">
      <Content />
    </div>
  </article>
</Layout>
