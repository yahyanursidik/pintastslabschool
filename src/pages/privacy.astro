---
import Layout from '../layouts/Layout.astro';
import siteSettings from '../content/siteSettings/siteSettings.json';
---

<Layout title={'Kebijakan privasi | ' + siteSettings.schoolName} description={'Kebijakan privasi ' + siteSettings.schoolName + '.'}>
  <article class="inner-page">
    <h1>Kebijakan Privasi</h1>
    <div class="article-body">
      <h2>Pendahuluan</h2>
      <p>{siteSettings.schoolName} ("kami", "milik kami") menghormati privasi Anda dan berkomitmen untuk melindungi data pribadi Anda.</p>

      <h2>Informasi yang kami kumpulkan</h2>
      <p>Kami dapat mengumpulkan informasi identitas pribadi (Nama, Alamat Email, Nomor Telepon) ketika Anda menghubungi kami melalui formulir kontak atau mendaftar SPMB.</p>

      <h2>Penggunaan informasi</h2>
      <p>Informasi yang kami kumpulkan digunakan untuk:</p>
      <ul>
        <li>Menyediakan layanan informasi pendidikan.</li>
        <li>Menghubungi Anda terkait pendaftaran dan pertanyaan.</li>
        <li>Meningkatkan layanan website kami.</li>
      </ul>

      <h2>Hubungi kami</h2>
      <p>Jika Anda memiliki pertanyaan tentang Kebijakan Privasi ini, silakan hubungi admin kami.</p>
      <a href={'mailto:' + siteSettings.email}>{siteSettings.email}</a>
    </div>
  </article>
</Layout>
