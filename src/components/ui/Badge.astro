---
interface Props {
  variant?: 'default' | 'sage' | 'gold' | 'outline';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const baseStyles = 'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2';

const variants = {
  default: 'bg-muted-gold text-white',
  sage: 'bg-sage-green/20 text-deep-olive',
  gold: 'bg-muted-gold/20 text-muted-gold',
  outline: 'border border-sage-green text-charcoal-soft',
};

const classes = `${baseStyles} ${variants[variant]} ${className}`;
---

<div class={classes}>
  <slot />
</div>
