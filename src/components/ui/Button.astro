---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className,
  ...rest
} = Astro.props;
const classes = ['button', 'button--' + variant, 'button--' + size, className];
---

{href ? (
  <a href={href} class:list={classes} {...rest}><slot /></a>
) : (
  <button type="button" class:list={classes} {...rest}><slot /></button>
)}
