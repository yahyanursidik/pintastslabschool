---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { title, subtitle, align = 'center', class: className = '' } = Astro.props;
---

<div class={`flex flex-col gap-2 ${align === 'center' ? 'items-center text-center' : 'items-start text-left'} ${className}`}>
  <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-deep-olive">
    {title}
  </h2>
  {subtitle && (
    <p class="text-sm md:text-base text-charcoal-soft/80 max-w-xl">
      {subtitle}
    </p>
  )}
</div>
