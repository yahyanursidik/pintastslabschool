---
import HeroHub from '../hub/HeroHub.astro';

interface Props {
  schoolName: string;
  shortName: string;
  logo?: string;
}

const { schoolName, shortName, logo } = Astro.props;
const isHub = Astro.url.pathname === '/';
---

<header class:list={['shell', isHub ? 'hub-header' : 'inner-header']}>
  {isHub ? (
    <HeroHub schoolName={schoolName} logo={logo} />
  ) : (
    <nav aria-label="Navigasi utama">
      <a class="text-link" href="/">Pintas {shortName}</a>
    </nav>
  )}
</header>
