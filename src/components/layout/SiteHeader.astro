---
import Button from '../ui/Button.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-sage-green/20 bg-ivory/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[720px] items-center justify-between px-4 sm:px-6">
    <div class="flex items-center gap-2">
      <!-- Placeholder for Logo -->
      <div class="h-8 w-8 rounded-full bg-sage-green/20 flex items-center justify-center text-deep-olive font-bold text-xs">
        TS
      </div>
      <span class="font-semibold text-deep-olive hidden sm:inline-block">TS Lab School</span>
    </div>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-charcoal-soft/80">
      <a href="/hub" class="hover:text-deep-olive transition-colors">Hub</a>
      <a href="/#spmb" class="hover:text-deep-olive transition-colors">SPMB</a>
      <a href="/#programs" class="hover:text-deep-olive transition-colors">Programs</a>
      <a href="/#updates" class="hover:text-deep-olive transition-colors">Updates</a>
      <a href="/#contact" class="hover:text-deep-olive transition-colors">Contact</a>
