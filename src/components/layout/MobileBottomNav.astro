---
import { Home, ClipboardList, GraduationCap, Newspaper } from 'lucide-astro';
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-ivory border-t border-sage-green/20 pb-safe shadow-[0_-4px_12px_rgba(79,93,58,0.05)]">
  <div class="flex items-center justify-around h-16 px-2 bottom-nav">
    <a href="/" class="flex flex-col items-center gap-1 p-2 text-charcoal-soft/60 hover:text-deep-olive transition-colors">
      <Home class="w-5 h-5" />
      <span class="text-[10px] font-medium">Hub</span>
    </a>
    <a href="/#spmb" class="flex flex-col items-center gap-1 p-2 text-charcoal-soft/60 hover:text-deep-olive transition-colors">
      <ClipboardList class="w-5 h-5" />
      <span class="text-[10px] font-medium">SPMB</span>
    </a>
    <a href="/#programs" class="flex flex-col items-center gap-1 p-2 text-charcoal-soft/60 hover:text-deep-olive transition-colors">
      <GraduationCap class="w-5 h-5" />
      <span class="text-[10px] font-medium">Program</span>
    </a>
    <a href="/#updates" class="flex flex-col items-center gap-1 p-2 text-charcoal-soft/60 hover:text-deep-olive transition-colors">
      <Newspaper class="w-5 h-5" />
      <span class="text-[10px] font-medium">Update</span>
    </a>
  </div>
</nav>

<style>
  /* Safe area padding for iOS */
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom);
  }
  
  /* Active state class to be added via JS or Astro current path logic */
  .active {
    color: var(--color-deep-olive);
  }
</style>

<script>
  // Simple active state toggle based on hash or path
  const currentPath = window.location.pathname;
  const navLinks = document.querySelectorAll('.bottom-nav a');
  
  function updateActiveLink() {
    const hash = window.location.hash || '/';
    const path = window.location.pathname;
    
    navLinks.forEach(link => {
      const href = link.getAttribute('href');
      link.classList.remove('text-sage-green', 'text-deep-olive');
      link.classList.add('text-charcoal-soft/60');
      
      if (href === path || href === `/${hash}` || (path === '/' && href === '/')) {
         link.classList.add('text-deep-olive');
         link.classList.remove('text-charcoal-soft/60');
      } else {
         link.classList.remove('text-deep-olive');
         link.classList.add('text-charcoal-soft/60');
      }
    });
  };

  // Run on load and hash change
  window.addEventListener('DOMContentLoaded', updateActiveLink);
  window.addEventListener('hashchange', updateActiveLink);
</script>
