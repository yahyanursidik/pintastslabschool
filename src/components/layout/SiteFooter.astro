---
interface Props {
  schoolName: string;
}

const { schoolName } = Astro.props;
const year = new Intl.DateTimeFormat('id-ID', { year: 'numeric', timeZone: 'Asia/Jakarta' }).format();
---

<footer class="shell site-footer">
  <p>© {year} {schoolName}</p>
  <nav aria-label="Tautan kaki halaman">
    <a href="/privacy">Kebijakan privasi</a>
  </nav>
</footer>
