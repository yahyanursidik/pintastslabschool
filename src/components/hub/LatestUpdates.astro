---
import SectionTitle from '../ui/SectionTitle.astro';
import Badge from '../ui/Badge.astro';
import { Calendar } from 'lucide-astro';

interface Update {
  title: string;
  slug: string;
  excerpt: string;
  category: string;
  publishedDate: string;
}

interface Props {
  updates: Update[];
}

const { updates } = Astro.props;

// Formatting date helper
const formatDate = (dateString: string) => {
  if (!dateString) return '';
  const date = new Date(dateString);
  return new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
};
---

<section id="updates" class="scroll-mt-24 flex flex-col gap-6 py-8">
  <SectionTitle title="Update Sekolah" align="left" />
  
  {updates.length === 0 ? (
    <div class="w-full bg-white rounded-3xl p-8 border border-sage-green/10 text-center flex flex-col items-center justify-center gap-3 min-h-[160px]">
      <p class="text-charcoal-soft/60 italic">Update sekolah akan tampil di sini.</p>
    </div>
  ) : (
    <div class="flex flex-col gap-4">
      {updates.map(update => (
        <a href={`/updates/${update.slug}`} class="group flex flex-col sm:flex-row gap-4 p-4 md:p-5 bg-white rounded-[24px] border border-sage-green/10 shadow-sm hover:shadow-md transition-all">
          <div class="flex-grow flex flex-col gap-2 justify-center">
            <div class="flex items-center gap-3">
              <Badge variant="sage">{update.category}</Badge>
              <span class="text-xs text-charcoal-soft/50 flex items-center gap-1">
                <Calendar class="w-3 h-3" />
                {formatDate(update.publishedDate)}
              </span>
            </div>
            <h4 class="font-bold text-lg text-deep-olive group-hover:text-muted-gold transition-colors line-clamp-1">{update.title}</h4>
            <p class="text-sm text-charcoal-soft/70 line-clamp-2">{update.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  )}
</section>
