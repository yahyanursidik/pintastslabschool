---
import type { Shortcut } from '../../lib/shortcuts';
import QuickLinkCard from './QuickLinkCard.astro';

interface Props {
  id: string;
  title: string;
  links: Shortcut[];
  priority?: boolean;
}

const { id, title, links, priority = false } = Astro.props;
const headingId = id + '-title';
---

<section class:list={['shortcut-group', { 'shortcut-group--priority': priority }]} id={id} aria-labelledby={headingId}>
  <h2 id={headingId}>{title}</h2>
  <ul class="shortcut-list" role="list">
    {links.map((link) => <QuickLinkCard {...link} />)}
  </ul>
</section>
