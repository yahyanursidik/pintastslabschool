---
import type { Shortcut } from '../../lib/shortcuts';

type Props = Shortcut;

const { id, title, description, url } = Astro.props;
const destinations = [
  ['https://drive.google.com/', 'Google Drive'],
  ['https://hub.tslabschool.sch.id/', 'Portal sekolah'],
];
const destination = destinations.find(([prefix]) => url.startsWith(prefix))?.[1];
---

<li id={id} class="shortcut">
  <a href={url}>
    <span class="shortcut-copy">
      <span class="shortcut-title">{title}</span>
      {description && <small>{description}</small>}
    </span>
    {destination && <span class="shortcut-destination">{destination}</span>}
  </a>
</li>
