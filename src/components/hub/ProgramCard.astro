---
import Button from '../ui/Button.astro';
import { ArrowRight, BookOpen, Shapes } from 'lucide-astro';

interface Props {
  title: string;
  level: 'preschool' | 'elementary';
  description: string;
  ctaLabel: string;
  ctaUrl: string;
}

const { title, level, description, ctaLabel, ctaUrl } = Astro.props;

const WatermarkIcon = level === 'elementary' ? BookOpen : Shapes;
---

<a href={ctaUrl} class="group relative flex flex-col gap-2 p-5 rounded-2xl bg-white shadow-sm border border-sage-green/10 transition-transform hover:-translate-y-0.5 overflow-hidden">
  
  <h3 class="text-sm font-heading font-semibold text-deep-olive z-10 relative">{title}</h3>
  <p class="text-[11px] font-body text-charcoal-soft/70 leading-relaxed min-h-[48px] z-10 relative">
    {description}
  </p>
  
  <div class="mt-4 flex items-center gap-1.5 text-xs font-semibold text-sage-green group-hover:text-deep-olive transition-colors z-10 relative">
    {ctaLabel} <ArrowRight class="w-3 h-3" stroke-width="2.5" />
  </div>

  <div class="absolute -right-4 -bottom-4 text-sage-green/5 pointer-events-none group-hover:text-sage-green/10 transition-colors z-0">
    <WatermarkIcon class="w-24 h-24" stroke-width="1.5" />
  </div>
</a>
