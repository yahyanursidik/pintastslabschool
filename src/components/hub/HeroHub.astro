---
interface Props {
  schoolName: string;
  logo?: string;
}

const { schoolName, logo } = Astro.props;
const originalLogo = logo === '/images/logo.png';
---

<div class="hub-identity">
  {logo && (
    <span class="school-stamp">
      <span class:list={['school-mark', { 'school-mark--original': originalLogo }]}>
        <img src={logo} width={originalLogo ? 1080 : 256} height={originalLogo ? 1350 : 256} alt="" />
      </span>
    </span>
  )}
  <div>
    <p class="hub-kicker">Pintas · Tautan resmi</p>
    <h1>{schoolName}</h1>
  </div>
</div>
