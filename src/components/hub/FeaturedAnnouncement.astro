---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { uniqueShortcuts } from '../../lib/shortcuts';
import QuickLinkCard from './QuickLinkCard.astro';

interface Props {
  announcements: CollectionEntry<'announcements'>[];
  portals: CollectionEntry<'quickLinks'>[];
  image: ImageMetadata;
  primaryCtaLabel?: string;
  primaryCtaUrl?: string;
  whatsappUrl: string;
}

const { announcements, portals, image, primaryCtaLabel, primaryCtaUrl, whatsappUrl } = Astro.props;
const notice = announcements.find(({ id }) => id === 'spmb') ?? announcements[0];
const isDestination = (url: string) => Boolean(url) && !['#', '#spmb', '/#spmb'].includes(url);
const configuredLink = primaryCtaLabel && primaryCtaUrl && isDestination(primaryCtaUrl)
  ? [{ title: primaryCtaLabel, url: primaryCtaUrl }]
  : [];
const portalLinks = [...portals]
  .sort((a, b) => Number(b.data.isFeatured) - Number(a.data.isFeatured))
  .map(({ data }) => data);
const [primary, ...related] = uniqueShortcuts([
  ...portalLinks,
  ...configuredLink,
  ...announcements.flatMap(({ data }) => data.ctaLabel && data.ctaUrl
    ? [{ title: data.ctaLabel, url: data.ctaUrl }]
    : []
  ),
].filter(({ url }) => isDestination(url)));
const registration = primary ?? (whatsappUrl
  ? { title: 'Tanya jadwal SPMB', url: whatsappUrl }
  : undefined
);
---

<section id="spmb" class="featured" aria-labelledby="spmb-title">
  {registration ? (
    <a href={registration.url} class="featured-link">
      <div class="featured-copy">
        <p>{notice?.data.badge || 'SPMB'}</p>
        <h2 id="spmb-title">{registration.title}</h2>
      </div>
      <span class="featured-art">
        <Image
          src={image}
          alt=""
          width={320}
          widths={[160, 256, 320]}
          sizes="(max-width: 30rem) 6.5rem, 10rem"
          format="webp"
          quality={77}
          loading="eager"
          fetchpriority="high"
        />
      </span>
    </a>
  ) : (
    <div class="featured-empty">
      <h2 id="spmb-title">Informasi SPMB</h2>
      <p>Tautan pendaftaran akan tampil saat sekolah menerbitkannya.</p>
    </div>
  )}
  {related.length > 0 && (
    <ul class="featured-related" aria-label="Tautan SPMB lainnya">
      {related.map((link) => <QuickLinkCard {...link} />)}
    </ul>
  )}
</section>
